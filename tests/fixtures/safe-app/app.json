{
  "expo": {
    "name": "SafeShop",
    "slug": "safeshop",
    "version": "1.0.0",
    "scheme": "com.example.safeshop",
    "android": {
      "package": "com.example.safeshop",
      "allowBackup": false,
      "permissions": ["CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.example.safeshop"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "https://api.safeshop.example"
    }
  }
}
